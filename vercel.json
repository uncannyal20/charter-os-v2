
{
  "version": 2,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/claude", "dest": "/api/claude.js" },
    { "src": "/api/save-charter", "dest": "/api/save-charter.js" },
    { "src": "/api/load-charter", "dest": "/api/load-charter.js" },
    { "src": "/api/get-all", "dest": "/api/get-all.js" },
    { "src": "/admin", "dest": "/public/admin.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
